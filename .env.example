# Development template only. Never place real credentials or key material here.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=kms
MONGO_USERS_COLLECTION=users
MONGO_DEK_COLLECTION=data_keys
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json

# Development-only example. Generate a unique 32-byte key and provide it
# through a secret manager. This raw-key configuration will be replaced by an
# external KMS/HSM provider in a later hardening step.
MASTER_KEYS=development-key-id:REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

TLS_CERT_PATH=certs/server.crt
TLS_KEY_PATH=certs/server.key

HTTP_ADDR=:8443
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
REQUEST_TIMEOUT=15s
MAX_REQUEST_BODY_BYTES=1048576
HTTP_MAX_HEADER_BYTES=1048576
RATE_LIMIT_REQUESTS_PER_SECOND=20
RATE_LIMIT_BURST=40
